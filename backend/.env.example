# Copy to backend/.env and fill in. Blank values use the defaults shown.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# --- Neon Postgres (for /trips). Get it from a teammate or the Neon console "Connect" button.
NEON_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require

# --- Ocean Networks Canada (for /api/ship/latest and /api/ship/history)
# Oceans 3.0 API token: https://data.oceannetworks.ca > Profile > Web Services API.
# Without it, /api/ship/* answers 503 {"detail": "onc_not_configured"}.
ONC_TOKEN=
ONC_BASE_URL=https://data.oceannetworks.ca/api
# Ship systems (TSG, TURBCHLFL, PVCS, ...) and navigation (NAV) locations.
ONC_LOCATION_CODE=TWSB
ONC_NAV_LOCATION_CODE=TWSB.N1
# Seconds to cache the NAV group (position, course, speed, heading, roll): one request per period
# at most, so the ship moves smoothly on the map.
ONC_NAV_CACHE_S=3
# Seconds to cache every other ONC group (TSG, TURBCHLFL, TEMPHUMID, BARPRESS, PVCS, ...).
ONC_CACHE_S=30
# Seconds to cache /api/ship/history per (minutes, step), so a burst of kiosk sessions makes one
# ONC read.
ONC_HISTORY_CACHE_S=20
# A sensor value more than this many seconds older than the NAV sample is returned as null.
ONC_MAX_SENSOR_AGE_S=300
# If the (newest) position is older than this (seconds), /api/ship/* answers 503 onc_stale.
ONC_MAX_POSITION_AGE_S=900
# East magnetic declination (degrees) at Swartz Bay-Tsawwassen, 2026; update every few years.
# Turns ORIENTATION magnetic_heading into a true heading. Only used when the NAV true heading is
# missing, and by scripts/export_sample_data.py.
MAGNETIC_DECLINATION_DEG=15.3

# --- OpenWeatherMap (weather part of /api/weather). Free key: https://openweathermap.org/api
# Without it the weather part is "unavailable" and only waves are returned.
OPENWEATHER_API_KEY=
# Seconds to cache weather per grid cell, and the grid size in degrees.
WEATHER_CACHE_S=600
WEATHER_GRID_DEG=0.02

# --- Open-Meteo Marine (waves part of /api/weather, no key needed)
MARINE_CACHE_S=900
# Point used when the requested cell has no wave data (near shore). Mid Strait of Georgia.
MARINE_FALLBACK_LAT=48.95
MARINE_FALLBACK_LON=-123.20

# --- DFO Integrated Water Level System (for /api/tides, no key needed)
DFO_BASE_URL=https://api-iwls.dfo-mpo.gc.ca/api/v1
# Tide stations; /api/tides uses the nearest. Swartz Bay, Miners Bay (Active Pass), Tsawwassen.
DFO_TIDE_STATIONS=07270,07528,07590
# Current station (Active Pass).
DFO_CURRENT_STATION=07527
# Seconds to cache one day of predictions per station (6 h).
DFO_CACHE_S=21600

# --- Captain's bridge screen (/bridge/{date}/* replay and /api/bridge/* live)
# Area of the bridge map and its data: south,north,west,east (degrees).
BRIDGE_BBOX=48.55,49.35,-123.75,-122.85
# Open-Meteo weather grid spacing (degrees), replay and live (the free tier counts every grid point as
# one call: 0.05 = 323 points; live reads it once per 3 h).
BRIDGE_WX_GRID_DEG=0.05
# Seconds to keep a finished past day from ONC, Open-Meteo and DFO in memory (7 days).
BRIDGE_PAST_CACHE_S=604800
# Timeout in seconds for whole-day upstream reads (ONC whole-day windows take longer than HTTP_TIMEOUT_S).
BRIDGE_DAY_TIMEOUT_S=90
# Seconds to cache the live bridge parts (ONC observatories, weather grid, CODAR).
BRIDGE_LIVE_CACHE_S=300
# ONC location of the Strait of Georgia CODAR (HF radar) surface currents.
ONC_CODAR_LOCATION_CODE=SOGCS

# --- Shared
# Timeout in seconds for every upstream request.
HTTP_TIMEOUT_S=10
# Comma-separated origins allowed by CORS (Vite dev server and preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
