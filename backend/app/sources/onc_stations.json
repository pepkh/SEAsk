      "lon": {"location": "TWDP.N1", "deviceCategory": "NAV", "sensorCategoryCode": "longitude", "digits": 5},
      "hdgDeg": {"location": "TWDP.N1", "deviceCategory": "NAV", "sensorCategoryCode": "heading", "aggregate": "newest", "digits": 0},
      "cogDeg": {"location": "TWDP.N1", "deviceCategory": "NAV", "sensorCategoryCode": "ship_course", "aggregate": "newest", "digits": 0},
      "sogKn": {"location": "TWDP.N1", "deviceCategory": "NAV", "sensorCategoryCode": "speed_over_ground", "unit": "kn", "digits": 1},
