      "sal": {"deviceCategory": "TSG", "sensorCategoryCode": "salinity", "digits": 2},
      "o2Sat": {"deviceCategory": "OXYSENSOR", "sensorCategoryCode": "oxygen_saturation", "digits": 1},
      "chl": {"deviceCategory": "TURBCHLFL", "sensorCategoryCode": "chlorophyll", "digits": 2},
