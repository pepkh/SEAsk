        "sal": {"deviceCategory": "CTD", "sensorCategoryCode": "salinity", "digits": 3},
        "sigmaT": {"deviceCategory": "CTD", "sensorCategoryCode": "sigma_t", "digits": 3},
        "soundSpeed": {"deviceCategory": "CTD", "sensorCategoryCode": "sound_speed", "digits": 2},
        "o2MlL": {"deviceCategory": "OXYSENSOR", "sensorCategoryCode": "oxygen_corrected", "digits": 3},
        "o2Sat": {"deviceCategory": "OXYSENSOR", "sensorCategoryCode": "oxygen_saturation", "digits": 2},
        "turb": {"deviceCategory": "TURBIDITYMETER", "sensorCategoryCode": "turbidity", "digits": 2}
      }
    },
    "IONA": {
      "name": "Iona (Fraser River mouth)", "kind": "shore", "lat": 49.2161, "lon": -123.2055, "depthM": null,
      "series": {
        "windKn": {"deviceCategory": "WINDMONITOR", "sensorCategoryCode": "windspeed", "unit": "kn", "aggregate": "mean", "digits": 1},
        "windFromDeg": {"deviceCategory": "WINDMONITOR", "sensorCategoryCode": "wind_direction_corrected", "aggregate": "vector", "weight": "windspeed", "digits": 0},
        "gustKn": {"deviceCategory": "WINDMONITOR", "sensorCategoryCode": "windspeed", "unit": "kn", "aggregate": "max", "digits": 1},
        "baroHpa": {"deviceCategory": "BARPRESS", "sensorCategoryCode": "barometric_pressure", "unit": "hPa", "digits": 1}
      }
    }
  },
  "twdp": {
