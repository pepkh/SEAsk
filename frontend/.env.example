# Copy this file to .env.local and change the values.

# Live data. true = ship feed (Ocean Networks Canada) and weather (OpenWeatherMap, Open-Meteo) from the
# backend at VITE_API_URL, falling back to the sample data when a source is down. false = sample data only.
# The texts (zones, species, quiz, landmarks) are always the bundled files in src/mocks/{en,fr}.
VITE_LIVE_DATA=false
VITE_API_URL=http://localhost:8000

# Map mode (CesiumJS, real terrain). true = show the globe button on the Journey screens.
# Without the offline tiles (public/tiles) the Journey screens use the 3D sea instead.
VITE_ENABLE_MAP_MODE=true
# Start mode of the Journey screens: sea | map
VITE_HOME_SCENE=map
# Offline imagery set for map mode: sentinel | nrcan
VITE_MAP_IMAGERY=sentinel
# Folder or server that holds the offline tiles and terrain.
VITE_TILES_URL=/tiles

# Speed of the sample ship feed. 1 = real time. 10 = demo (10 times faster).
VITE_REPLAY_SPEED=1
