# Copy this file to .env.local and change the values.

# Data source. true = mock JSON in src/mocks. false = backend API at VITE_API_URL.
VITE_USE_MOCKS=true
VITE_API_URL=http://localhost:8000

# Map mode (CesiumJS). true = show the globe button on the Journey screens.
VITE_ENABLE_MAP_MODE=false
# Start mode of the Journey screens: sea | map
VITE_HOME_SCENE=sea
# Offline imagery set for map mode: sentinel | nrcan
VITE_MAP_IMAGERY=sentinel
# Folder or server that holds the offline tiles and terrain.
VITE_TILES_URL=/tiles

# Speed of the mock ship feed. 1 = real time. 10 = demo (10 times faster).
VITE_REPLAY_SPEED=1
